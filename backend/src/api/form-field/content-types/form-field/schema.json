{
  "kind": "collectionType",
  "collectionName": "form_fields",
  "info": {
    "singularName": "form-field",
    "pluralName": "form-fields",
    "displayName": "Form field",
    "description": "Step-1 field definition per country (US-01). Use 'role' so pricing/masking find the field (ADR-0006)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "regex": "^[a-zA-Z][a-zA-Z0-9_]*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "text",
        "number",
        "select",
        "date",
        "checkbox"
      ],
      "required": true,
      "default": "text",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "section": {
      "type": "enumeration",
      "enum": [
        "policyholder",
        "vehicle"
      ],
      "required": true,
      "default": "policyholder",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "none",
        "fullName",
        "documentType",
        "documentNumber",
        "birthDate",
        "email",
        "phone",
        "city",
        "vehicleMake",
        "vehicleYear",
        "vehiclePlate",
        "vehicleUse"
      ],
      "required": true,
      "default": "none",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "required": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "placeholder": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "helpText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "errorMessage": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "requiredMessage": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "validation": {
      "type": "component",
      "repeatable": false,
      "component": "form.validation",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "options": {
      "type": "component",
      "repeatable": true,
      "component": "form.option",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "inversedBy": "formFields",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}